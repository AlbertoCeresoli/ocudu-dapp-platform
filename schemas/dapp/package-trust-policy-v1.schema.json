  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocudu:dapp:package-trust-policy:v1",
  "title": "OCUDU dApp offline package trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_epoch", "keys", "revoked_key_ids", "packages"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_epoch": {"type": "integer", "minimum": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key_spki"],
        "properties": {
          "key_id": {"$ref": "#/$defs/hash"},
          "algorithm": {"const": "ecdsa-p256-sha256"},
          "public_key_spki": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2048,
            "pattern": "^[0-9a-f]+$"
          }
        }
      }
    },
    "revoked_key_ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/hash"}
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package_id", "minimum_sequence"],
        "properties": {
          "package_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "minimum_sequence": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
