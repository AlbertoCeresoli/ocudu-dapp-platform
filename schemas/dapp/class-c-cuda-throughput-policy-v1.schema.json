{
  "SPDX-FileCopyrightText": "Copyright (C) 2026 DeepSig Inc.",
  "SPDX-License-Identifier": "BSD-3-Clause-Clear",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocudu:dapp:class-c-cuda-throughput-policy:v1",
  "title": "OCUDU Class-C CUDA process throughput policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SPDX-FileCopyrightText",
    "SPDX-License-Identifier",
    "schema",
    "platform_id",
    "channel_bandwidth_mhz",
    "common_scs_khz",
    "time_scaling",
    "srs_period_ms",
    "duration_seconds",
    "restart_cycles_before_measurement",
    "minimum_spectrum_tensor_bytes",
    "minimum_srs_tensor_bytes",
    "minimum_spectrum_publications_per_second",
    "minimum_srs_publications_per_second",
    "minimum_spectrum_export_gbps",
    "minimum_srs_export_gbps",
    "maximum_backpressure_drop_rate",
    "maximum_export_slot_high_watermark_ratio",
    "release_controls_approved",
    "controls_rationale"
  ],
  "properties": {
    "SPDX-FileCopyrightText": {"type": "string", "minLength": 1},
    "SPDX-License-Identifier": {"const": "BSD-3-Clause-Clear"},
    "schema": {"const": "ocudu.dapp.class-c-cuda-throughput-policy.v1"},
    "platform_id": {"type": "string", "minLength": 1},
    "channel_bandwidth_mhz": {"const": 100},
    "common_scs_khz": {"const": 30},
    "time_scaling": {"const": 1},
    "srs_period_ms": {"enum": [5, 10, 20, 40, 80, 160, 320, 640, 1280]},
    "duration_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
    "restart_cycles_before_measurement": {"type": "integer", "minimum": 1, "maximum": 100},
    "minimum_spectrum_tensor_bytes": {"type": "integer", "minimum": 183456},
    "minimum_srs_tensor_bytes": {"type": "integer", "minimum": 1},
    "minimum_spectrum_publications_per_second": {"type": "number", "minimum": 0},
    "minimum_srs_publications_per_second": {"type": "number", "minimum": 0},
    "minimum_spectrum_export_gbps": {"type": "number", "minimum": 0},
    "minimum_srs_export_gbps": {"type": "number", "minimum": 0},
    "maximum_backpressure_drop_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "maximum_export_slot_high_watermark_ratio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "release_controls_approved": {"type": "boolean"},
    "controls_rationale": {"type": "string", "minLength": 1},
    "operator_notes": {"type": "string"}
  }
}
