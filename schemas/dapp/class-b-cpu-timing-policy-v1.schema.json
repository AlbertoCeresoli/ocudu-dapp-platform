{
  "SPDX-FileCopyrightText": "Copyright (C) 2026 DeepSig Inc.",
  "SPDX-License-Identifier": "BSD-3-Clause-Clear",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ocudu:dapp:class-b-cpu-timing-policy:v1",
  "title": "OCUDU Class-B CPU timing policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SPDX-FileCopyrightText",
    "SPDX-License-Identifier",
    "schema",
    "platform_id",
    "deadline_ns",
    "repetitions",
    "warmups",
    "maximum_p999_ns",
    "maximum_deadline_miss_rate",
    "maximum_fallback_rate",
    "maximum_validation_rejection_rate",
    "required_scheduler_policy",
    "minimum_scheduler_priority",
    "required_cpu_affinity",
    "cpu_frequency_policy",
    "release_controls_approved",
    "controls_rationale"
  ],
  "properties": {
    "SPDX-FileCopyrightText": {"type": "string", "minLength": 1},
    "SPDX-License-Identifier": {"const": "BSD-3-Clause-Clear"},
    "schema": {"const": "ocudu.dapp.class-b-cpu-timing-policy.v1"},
    "platform_id": {"type": "string", "minLength": 1},
    "deadline_ns": {"const": 100000},
    "repetitions": {"const": 1000},
    "warmups": {"const": 100},
    "maximum_p999_ns": {"const": 100000},
    "maximum_deadline_miss_rate": {"const": 0},
    "maximum_fallback_rate": {"const": 0},
    "maximum_validation_rejection_rate": {"const": 0},
    "required_scheduler_policy": {"enum": ["fifo", "round-robin", "batch", "idle", "other"]},
    "minimum_scheduler_priority": {"type": "integer", "minimum": 0},
    "required_cpu_affinity": {"type": "string", "pattern": "^[0-9,-]+$"},
    "cpu_frequency_policy": {"type": "string", "minLength": 1},
    "release_controls_approved": {"type": "boolean"},
    "controls_rationale": {"type": "string", "minLength": 1},
    "operator_notes": {"type": "string"}
  }
}
