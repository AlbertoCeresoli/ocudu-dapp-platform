@@ -0,0 +1,151 @@
+/**
+ * @file test_role_aware_connector_sctp.cpp
+ * @brief SctpAssociationE3Connector: one association carries setup, inbound
+ *        and outbound traffic with SCTP message boundaries.
+ *
+ * Skips (passes) when the host has no SCTP support: ubuntu-latest CI runners
+ * lack the sctp kernel module, and a build with LIBE3_ENABLE_SCTP=OFF cannot
+ * create the socket either.
