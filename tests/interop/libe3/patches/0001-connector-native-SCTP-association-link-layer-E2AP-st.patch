+#include "test_framework.hpp"
+#include "libe3/types.hpp"
+#include "libe3/e3_connector.hpp"
+
+#include <atomic>
+#include <chrono>
+#include <iostream>
+#include <cstring>
+#include <netinet/in.h>
+#include <string>
+#include <sys/socket.h>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+using namespace libe3;
+using namespace std::chrono_literals;
+
+namespace {
+
+bool host_has_sctp() {
+    int fd = socket(AF_INET, SOCK_STREAM, IPPROTO_SCTP);
+    if (fd < 0) return false;
+    close(fd);
+#ifdef LIBE3_ENABLE_SCTP
+    return true;
+#else
+    return false;
+#endif
+}
+
+std::vector<uint8_t> bytes(const char* text) {
+    return std::vector<uint8_t>(text, text + std::strlen(text));
+}
+
+}  // namespace
+
+TEST(sctp_association_setup_inbound_outbound_share_one_association) {
+    if (!host_has_sctp()) {
+        std::cout << "  (SCTP unavailable on this host; skipped)\n";
+        return;
+    }
+    const uint16_t port = 25990;
+
+    auto ran = create_connector(E3LinkLayer::SCTP_ASSOCIATION, E3TransportLayer::SCTP,
+                                "sctp://127.0.0.1", "", "", port, 0, 0,
+                                /*io_threads=*/1, E3Role::RAN);
+    ASSERT_TRUE(ran != nullptr);
+    ASSERT_TRUE(ran->link_layer() == E3LinkLayer::SCTP_ASSOCIATION);
+    ASSERT_TRUE(ran->setup_initial_connection() == ErrorCode::SUCCESS);
+    ASSERT_TRUE(ran->setup_inbound_connection() == ErrorCode::SUCCESS);
+    ASSERT_TRUE(ran->setup_outbound_connection() == ErrorCode::SUCCESS);
+
+    auto dapp = create_connector(E3LinkLayer::SCTP_ASSOCIATION, E3TransportLayer::SCTP,
+                                 "sctp://127.0.0.1", "", "", port, 0, 0,
+                                 /*io_threads=*/1, E3Role::DAPP);
+    ASSERT_TRUE(dapp != nullptr);
+
+    // RAN side: the inbound loop reads the association; the first message of
+    // a fresh peer is routed to the setup channel, later ones are inbound.
+    std::vector<uint8_t> setup_rx;
+    std::vector<uint8_t> inbound_rx;
+    std::atomic<bool> stop{false};
+    std::thread inbound_t([&]() {
+        std::vector<uint8_t> buf;
+        while (!stop.load()) {
+            int n = ran->receive(buf);
+            if (n > 0) {
+                inbound_rx = buf;
+            }
+        }
+    });
+    std::thread setup_t([&]() {
+        for (int i = 0; i < 40; ++i) {
+            int n = ran->recv_setup_request(setup_rx);
+            if (n > 0) {
+                ran->send_response(bytes("setup-ok"));
+                return;
+            }
+        }
+    });
+
+    ASSERT_TRUE(dapp->setup_initial_connection_client() == ErrorCode::SUCCESS);
+    ASSERT_TRUE(dapp->setup_inbound_connection_client() == ErrorCode::SUCCESS);
+    ASSERT_TRUE(dapp->setup_outbound_connection_client() == ErrorCode::SUCCESS);
+    ASSERT_TRUE(dapp->send_setup_request_client(bytes("setup-req")) == ErrorCode::SUCCESS);
+
+    std::vector<uint8_t> resp;
+    int n = 0;
+    for (int i = 0; i < 40 && n == 0; ++i) {
+        n = dapp->recv_setup_response_client(resp);
+    }
+    setup_t.join();
+    ASSERT_TRUE(n > 0);
+    ASSERT_TRUE(resp == bytes("setup-ok"));
+    ASSERT_TRUE(setup_rx == bytes("setup-req"));
+
+    // dApp -> RAN after setup: inbound.
+    ASSERT_TRUE(dapp->send(bytes("control")) == ErrorCode::SUCCESS);
+    for (int i = 0; i < 100 && inbound_rx.empty(); ++i) {
+        std::this_thread::sleep_for(10ms);
+    }
+    ASSERT_TRUE(inbound_rx == bytes("control"));
+
+    // RAN -> dApp: outbound broadcast reaches the set-up peer, and a message
+    // larger than one recvmsg() call arrives whole (SCTP boundaries, no
+    // length prefix).
+    std::vector<uint8_t> big(200 * 1024);
+    for (size_t i = 0; i < big.size(); ++i) big[i] = static_cast<uint8_t>(i * 7);
+    ASSERT_TRUE(ran->send(bytes("indication")) == ErrorCode::SUCCESS);
+    ASSERT_TRUE(ran->send(big) == ErrorCode::SUCCESS);
+    std::vector<uint8_t> rx;
+    n = 0;
+    for (int i = 0; i < 40 && n == 0; ++i) n = dapp->receive(rx);
+    ASSERT_TRUE(n > 0);
+    ASSERT_TRUE(rx == bytes("indication"));
+    n = 0;
+    for (int i = 0; i < 40 && n == 0; ++i) n = dapp->receive(rx);
+    ASSERT_EQ(static_cast<size_t>(n), big.size());
+    ASSERT_TRUE(rx == big);
+
+    stop.store(true);
+    ran->shutdown();
+    inbound_t.join();
+    dapp->dispose();
+    ran->dispose();
+}
+
+TEST(sctp_association_factory_rejects_other_transports) {
+    auto conn = create_connector(E3LinkLayer::SCTP_ASSOCIATION, E3TransportLayer::TCP,
+                                 "", "", "", 1, 2, 3, 1, E3Role::RAN);
+    ASSERT_TRUE(conn == nullptr);
+}
+
+int main() {
+    return RUN_ALL_TESTS();
+}
